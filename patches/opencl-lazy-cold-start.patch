+// T29 cold start (GGML_OPENCL_LAZY=1, only on a cache miss): a program none of whose kernels the TTS launches is not compiled
+// (Adreno compiles serially, ~145 ms each, 263 of 292 programs): it becomes one shared empty program, every kernel made from it is
+// the empty kernel vq_stub. Launching such a kernel is a bug of the list below and aborts in clSetKernelArg (loud).
+static cl_program vq_stub_prog = nullptr;
+static cl_kernel vq_create_kernel(cl_program p, const char * name, cl_int * err) {
+    return clCreateKernel(p, p == vq_stub_prog ? "vq_stub" : name, err);
+}
+#define clCreateKernel vq_create_kernel
+static bool vq_tts_uses(const char * src, const std::string & opts) {
+    static const std::set<std::string> used = {
+        "kernel_add", "kernel_add_row", "kernel_concat_b4", "kernel_concat_b4_pack", "kernel_convert_block_q8_0", "kernel_cpy_f16_f16",
+        "kernel_cpy_f32_f32", "kernel_cpy_f32_f32_flat", "kernel_cpy_f32_f32_pack", "kernel_gemm_noshuffle_q8_0_f32", "kernel_gemv_noshuffle_q8_0_f32",
+        "kernel_get_rows_f32", "kernel_iq1_s_grid_export", "kernel_iq2_s_grid_export", "kernel_iq2_xs_grid_export", "kernel_iq2_xxs_grid_export",
+        "kernel_iq3_s_grid_export", "kernel_iq3_xxs_grid_export", "kernel_mul", "kernel_mul_mat_f16_f32_l4_dr_ls", "kernel_mul_mat_f16_f32_l4_x8_gqa_r4_img",
+        "kernel_mul_mm_f16_f32_l4_lm", "kernel_mul_mm_f16_f32_l4_lm_n8", "kernel_mul_mm_q8_0_f32_l4_lm", "kernel_mul_mv_q8_0_f32_flat", "kernel_mul_row",
+        "kernel_rms_norm_mul", "kernel_rms_norm_mul_add", "kernel_rope_neox_f32", "kernel_scale_f32_4", "kernel_set_rows_f16_i64", "kernel_sigmoid_f32",
+        "kernel_soft_max_4", "kernel_ssm_conv_f32_f32", "kernel_swiglu", "kernel_transpose_16_buf", "kernel_transpose_32_16", "kernel_transpose_32_buf",
+        "mul_mm_f16_f32_kq" };
+    const std::string t = std::string(src) + " " + opts;
+    const auto id = [](char c) { return isalnum((unsigned char) c) || c == '_'; };
+    for (const std::string & u : used) {   // whole word in the source or in the -D options (kernel names set by -DKERNEL_NAME_LM=...)
+        for (size_t p = t.find(u); p != std::string::npos; p = t.find(u, p + 1)) {
+            if ((p == 0 || !id(t[p - 1])) && (p + u.size() >= t.size() || !id(t[p + u.size()]))) return true;
+        }
+    }
+    for (size_t p = t.find("##"); p != std::string::npos; p = t.find("##", p + 2)) {   // names made by macro: kernel_concat_##SUFFIX
+        size_t b = p; while (b > 0 && id(t[b - 1])) b--;
+        const std::string pre = t.substr(b, p - b);
+        for (const std::string & u : used) if (!pre.empty() && u.compare(0, pre.size(), pre) == 0) return true;
+    }
+    return false;
+}

diff --git a/ggml/src/ggml-cpu/ggml-cpu-vq.h b/ggml/src/ggml-cpu/ggml-cpu-vq.h
new file mode 100644
index 0000000..3f47ea1
--- /dev/null
+++ b/ggml/src/ggml-cpu/ggml-cpu-vq.h
@@ -0,0 +1,92 @@
+#pragma once
+
+// VQS-BEGIN ggml-cpu-vq.h (contatori: la patch puo' cambiarli, eval stampa "contatori: modificati")
+// harness voce-quest (prelude, contratto v5): contatori per thread, attivi solo con VQ_CTR=1 nell'ambiente.
+// Un contatore per (pool, thread): pool 0 = persistente (llama, backbone), pool 1 = a perdere (creato e distrutto a ogni grafo: depthformer, codec).
+// Ogni contatore e' scritto solo dal suo thread (nessun atomico); il main legge gli snapshot a grafi fermi, tra un frame e l'altro.
+// Unita' di tempo: tick del contatore del processore (cntvct_el0 su arm64, hz in snapshot), nodo per nodo, mai dentro i pezzi di righe.
+
+#include <stdint.h>
+#include <time.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define GGML_VQ_NT   8      // thread contati per pool
+#define GGML_VQ_NF   12     // campi per contatore (vedi ggml_vq_field)
+
+enum ggml_vq_field {
+    GGML_VQ_ROWS,           // righe di peso lette nei pezzi presi da questo thread (generico, mul_mat_id, repack; llamafile: stima ne01/nth)
+    GGML_VQ_BYTES,          // byte di peso di quelle righe
+    GGML_VQ_WORK,           // tick dentro ggml_compute_forward, meno l'attesa alle barriere interne all'operazione
+    GGML_VQ_BARRIER,        // tick di attesa in ggml_barrier (ultimo arrivato: 0)
+    GGML_VQ_IDLE,           // tick in attesa di un nuovo grafo (thread secondari: poll + sonno)
+    GGML_VQ_STRAG,          // volte che questo thread e' arrivato ultimo a una barriera
+    GGML_VQ_STRAG_LATE,     // somma, su quelle volte, di (arrivo ultimo - arrivo primo) = quanto ha fatto aspettare gli altri
+    GGML_VQ_NODES,          // nodi calcolati
+    GGML_VQ_NBAR,           // barriere attraversate
+    GGML_VQ_GRAPHS,         // grafi cui ha partecipato
+    GGML_VQ_GRAPH_T,        // tick dentro ggml_graph_compute_thread (lavoro + barriere + giri)
+    GGML_VQ_SPARE,
+};
+
+struct ggml_vq_ctr {
+    uint64_t v[GGML_VQ_NF];
+    uint64_t arr;           // tick di arrivo all'ultima barriera
+    uint64_t pad[(128 - (GGML_VQ_NF + 1) * 8) / 8];
+} __attribute__((aligned(128)));
+
+struct ggml_vq_pool {
+    uint64_t graphs;        // chiamate a ggml_graph_compute
+    uint64_t graph_t;       // tick di muro in ggml_graph_compute (per i pool a perdere: creazione, calcolo, distruzione)
+    uint64_t pools;         // pool a perdere creati
+    uint64_t pool_t;        // tick per creare e distruggere i pool a perdere (thread create + join)
+};
+
+extern int                 ggml_vq_on;
+extern __thread struct ggml_vq_ctr * ggml_vq_cur;
+extern struct ggml_vq_ctr  ggml_vq_g[2][GGML_VQ_NT];
+extern struct ggml_vq_pool ggml_vq_p[2];
+
+static inline uint64_t ggml_vq_now(void) {
+#if defined(__aarch64__)
+    uint64_t t;
+    __asm__ volatile("mrs %0, cntvct_el0" : "=r"(t));
+    return t;
+#else
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t) ts.tv_sec * 1000000000ull + (uint64_t) ts.tv_nsec;
+#endif
+}
+
+// righe e byte di peso presi dal thread corrente; ctr nullo = contatori spenti
+#define GGML_VQ_ROWS_ADD(n, row_bytes) do { \
+        struct ggml_vq_ctr * vq_c_ = ggml_vq_cur; \
+        if (vq_c_) { vq_c_->v[GGML_VQ_ROWS] += (uint64_t) (n); vq_c_->v[GGML_VQ_BYTES] += (uint64_t) (n) * (uint64_t) (row_bytes); } \
+    } while (0)
+
+// copia dei contatori: ctr = [2][GGML_VQ_NT][GGML_VQ_NF], pool = [2][4], ritorna i tick al secondo
+uint64_t ggml_vq_snapshot(uint64_t * ctr, uint64_t * pool);
+
+#ifdef __cplusplus
+}
+#endif
+// VQS-END ggml-cpu-vq.h
+
+// VQ-BEGIN clock
+// microsecondi dal contatore del processore (cntvct_el0 / cntfrq_el0): l'orologio della metrica, mai ggml_time_us (sta fuori dal prelude)
+static inline int64_t ggml_vq_us(void) {
+#if defined(__aarch64__)
+    uint64_t t, f;
+    __asm__ volatile("mrs %0, cntvct_el0" : "=r"(t));
+    __asm__ volatile("mrs %0, cntfrq_el0" : "=r"(f));
+    return (int64_t) ((t / f) * 1000000ull + (t % f) * 1000000ull / f);
+#else
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (int64_t) ts.tv_sec * 1000000 + (int64_t) ts.tv_nsec / 1000;
+#endif
+}
+// VQ-END clock

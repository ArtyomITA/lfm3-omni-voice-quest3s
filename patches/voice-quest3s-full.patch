diff --git a/tools/tts/vq.h b/tools/tts/vq.h
new file mode 100644
index 0000000..4e8b1df
--- /dev/null
+++ b/tools/tts/vq.h
@@ -0,0 +1,293 @@
+#pragma once
+
+// VQ-BEGIN vq.h
+// harness voce-quest (prelude, contratto v5): modo batch di llama-tts. Uguale per base e patch, mai in kernel.patch.
+//   VQ_BATCH=<manifest>  una riga per sintesi: nome<TAB>file_testo[<TAB>w]  (w = riscaldamento, non misurata)
+//   VQ_OUT=<prefisso>    scrive <prefisso><nome>.wav, <prefisso><nome>.codes (int32 LE, 12 per frame) e accoda <prefisso>vq.jsonl
+//   VQ_CTR=1             contatori per thread dentro ggml-cpu (ggml-cpu-vq.h)
+//   VQ_SYS=<f1:f2:...>   file di sistema letti prima e dopo ogni sintesi (testo grezzo nel json)
+//   VQ_TASKS=1           /proc/self/task/*/{comm,schedstat} prima e dopo (tempo in coda di esecuzione per thread)
+//   VQ_CLEAR_DATA=1      azzera anche i dati della KV tra una frase e l'altra (default: solo i metadati)
+// Ogni sintesi riparte da zero: KV svuotata, sampler azzerato (seme), stato del codec e rng del MaskGIT rifatti da set_input.
+// Il testo si legge come -f (un solo \n finale tolto). Il programma non calcola hash: li calcola il PC sui file tirati dal visore.
+
+#include "../../ggml/src/ggml-cpu/ggml-cpu-vq.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+#ifdef __linux__
+#include <dirent.h>
+#endif
+
+static std::string vq_read(const std::string & path) {
+    std::string out;
+    FILE * f = fopen(path.c_str(), "rb");
+    if (!f) {
+        return out;
+    }
+    char buf[4096];
+    size_t n;
+    while ((n = fread(buf, 1, sizeof buf, f)) > 0) {
+        out.append(buf, n);
+    }
+    fclose(f);
+    return out;
+}
+
+static std::string vq_json(const std::string & s) {
+    std::string o = "\"";
+    for (unsigned char c : s) {
+        if (c == '"' || c == '\\') { o += '\\'; o += (char) c; }
+        else if (c == '\n') { o += "\\n"; }
+        else if (c == '\t') { o += "\\t"; }
+        else if (c < 0x20) { char b[8]; snprintf(b, sizeof b, "\\u%04x", c); o += b; }
+        else { o += (char) c; }
+    }
+    return o + "\"";
+}
+
+static std::string vq_tasks() {
+    std::string o;
+#ifdef __linux__
+    if (DIR * d = opendir("/proc/self/task")) {
+        while (dirent * e = readdir(d)) {
+            if (e->d_name[0] < '0' || e->d_name[0] > '9') {
+                continue;
+            }
+            std::string base = std::string("/proc/self/task/") + e->d_name;
+            std::string comm = vq_read(base + "/comm");
+            while (!comm.empty() && (comm.back() == '\n' || comm.back() == ' ')) { comm.pop_back(); }
+            std::string ss = vq_read(base + "/schedstat");
+            while (!ss.empty() && ss.back() == '\n') { ss.pop_back(); }
+            o += std::string(e->d_name) + " " + comm + " " + ss + "\n";
+        }
+        closedir(d);
+    }
+#endif
+    return o;
+}
+
+static std::string vq_sys(const std::vector<std::string> & files, bool tasks) {
+    std::string o = "{";
+    bool first = true;
+    for (const auto & f : files) {
+        o += std::string(first ? "" : ",") + vq_json(f) + ":" + vq_json(vq_read(f));
+        first = false;
+    }
+    if (tasks) {
+        o += std::string(first ? "" : ",") + "\"tasks\":" + vq_json(vq_tasks());
+    }
+    return o + "}";
+}
+
+// snapshot dei contatori ggml: [2][GGML_VQ_NT][GGML_VQ_NF] + pool [2][4], come array json piatto
+static std::string vq_ctr_json(uint64_t * hz) {
+    static uint64_t ctr[2 * GGML_VQ_NT * GGML_VQ_NF], pool[8];
+    *hz = ggml_vq_snapshot(ctr, pool);
+    std::string o = "[";
+    for (int i = 0; i < 2 * GGML_VQ_NT * GGML_VQ_NF; i++) { o += std::to_string(ctr[i]) + ","; }
+    for (int i = 0; i < 8; i++) { o += std::to_string(pool[i]) + (i < 7 ? "," : ""); }
+    return o + "]";
+}
+
+template <typename T>
+static std::string vq_arr(const std::vector<T> & v) {
+    std::string o = "[";
+    for (size_t i = 0; i < v.size(); i++) { o += std::to_string(v[i]) + (i + 1 < v.size() ? "," : ""); }
+    return o + "]";
+}
+
+static std::vector<std::string> vq_split(const std::string & s, char sep) {
+    std::vector<std::string> r;
+    size_t i = 0;
+    while (i <= s.size()) {
+        size_t j = s.find(sep, i);
+        if (j == std::string::npos) { j = s.size(); }
+        if (j > i) { r.push_back(s.substr(i, j - i)); }
+        i = j + 1;
+    }
+    return r;
+}
+
+static int vq_batch_run(const common_params & params, llama_context * lctx, common_sampler * smpl,
+                        const common_chat_templates * tmpls, mtmd_bitmap * speaker, mtmd_helper::gen_audio & gen,
+                        const std::string & manifest_path) {
+    const char * e_out = getenv("VQ_OUT");
+    const std::string out_pre = e_out ? e_out : "vq_";
+    const char * e_sys = getenv("VQ_SYS");
+    const std::vector<std::string> sys_files = e_sys ? vq_split(e_sys, ':') : std::vector<std::string>();
+    const char * e_tasks = getenv("VQ_TASKS");
+    const bool tasks = e_tasks && atoi(e_tasks) != 0;
+    const char * e_cd = getenv("VQ_CLEAR_DATA");
+    const bool clear_data = e_cd && atoi(e_cd) != 0;
+    const int n_skip = 8; // frame scartati dalla finestra misurata (contratto v5)
+
+    const std::string manifest = vq_read(manifest_path);
+    if (manifest.empty()) {
+        LOG_ERR("VQ_BATCH: manifest %s vuoto o illeggibile\n", manifest_path.c_str());
+        return 1;
+    }
+    FILE * jl = fopen((out_pre + "vq.jsonl").c_str(), "ab");
+    if (!jl) {
+        LOG_ERR("VQ_BATCH: non posso scrivere %svq.jsonl\n", out_pre.c_str());
+        return 1;
+    }
+    {
+        uint64_t hz = 0;
+        vq_ctr_json(&hz);
+        std::string m = "{\"meta\":{\"hz\":" + std::to_string(hz) + ",\"nt\":" + std::to_string(GGML_VQ_NT) + ",\"nf\":" + std::to_string(GGML_VQ_NF) +
+            ",\"fields\":[\"rows\",\"bytes\",\"work\",\"barrier\",\"idle\",\"strag\",\"strag_late\",\"nodes\",\"nbar\",\"graphs\",\"graph_t\",\"spare\"]" +
+            ",\"pool_fields\":[\"graphs\",\"graph_t\",\"pools\",\"pool_t\"],\"vq_ctr\":" + std::to_string(ggml_vq_on) +
+            ",\"n_threads\":" + std::to_string(params.cpuparams.n_threads) + ",\"n_skip\":" + std::to_string(n_skip) +
+            ",\"clear_data\":" + std::to_string(clear_data) + ",\"seed\":" + std::to_string(params.sampling.seed) + "}}\n";
+        fwrite(m.data(), 1, m.size(), jl);
+        fflush(jl);
+    }
+
+    const int max_new = params.n_predict > 0 ? params.n_predict : 512;
+    int n_ok = 0;
+    for (const std::string & line : vq_split(manifest, '\n')) {
+        const std::vector<std::string> col = vq_split(line, '\t');
+        if (col.size() < 2) {
+            continue;
+        }
+        const std::string & name = col[0];
+        const bool warm = col.size() > 2 && col[2] == "w";
+        std::string text = vq_read(col[1]);
+        if (!text.empty() && text.back() == '\n') {
+            text.pop_back();
+        }
+        std::string prompt = common_chat_get_tts_prompt(tmpls, text, params.tts_lang, params.tts_voice);
+        if (prompt.empty()) {
+            prompt = text;
+        }
+
+        const int64_t t_w0 = ggml_vq_us();
+        const std::string sys0 = vq_sys(sys_files, tasks);
+
+        // reset completo: come un processo appena avviato
+        llama_memory_clear(llama_get_memory(lctx), clear_data);
+        common_sampler_reset(smpl);
+        mtmd_helper_vq_clear();
+
+        mtmd_helper_gen_audio_inp inp = mtmd_helper_gen_audio_inp_default();
+        inp.seq_id      = 0;
+        inp.prompt      = prompt.c_str();
+        inp.prompt_len  = prompt.size();
+        inp.speaker_ref = speaker;
+        inp.lang        = params.tts_lang.c_str();
+        inp.top_k       = params.sampling.top_k;
+        inp.top_p       = params.sampling.top_p;
+        inp.seed        = params.sampling.seed;
+        if (gen.set_input(&inp) != 0) {
+            LOG_ERR("VQ_BATCH %s: set_input failed\n", name.c_str());
+            return 1;
+        }
+
+        const int64_t t_p0 = ggml_vq_us();
+        for (;;) {
+            const int32_t ret = gen.step_prompt(params.n_batch);
+            if (ret < 0) {
+                LOG_ERR("VQ_BATCH %s: prompt processing failed\n", name.c_str());
+                return 1;
+            }
+            if (ret == 0) {
+                break;
+            }
+        }
+        const int64_t t_p1 = ggml_vq_us();
+
+        llama_token sampled = common_sampler_sample(smpl, lctx, -1);
+        common_sampler_accept(smpl, sampled, true);
+        const float * h_state = llama_get_embeddings_ith(lctx, -1);
+
+        uint64_t hz = 0;
+        const std::string ctr_a = vq_ctr_json(&hz); // inizio generazione
+        std::string ctr_b;                          // dopo n_skip frame: inizio finestra misurata
+        std::vector<int64_t> f_us, d_us, c_us, b_us;
+        const int64_t * st = mtmd_helper_vq_stage_us();
+        bool stop = false;
+        int n_frames = 0;
+        const int64_t t_g0 = ggml_vq_us();
+        while (!stop && n_frames < max_new) {
+            const float * h_next = nullptr;
+            const int64_t s0[3] = { st[0], st[1], st[2] };
+            const int64_t t0 = ggml_vq_us();
+            if (gen.step_gen(sampled, h_state, &h_next, &stop) != 0) {
+                LOG_ERR("VQ_BATCH %s: step_gen failed at frame %d\n", name.c_str(), n_frames);
+                return 1;
+            }
+            if (!h_next) {
+                break;
+            }
+            n_frames++;
+            h_state = h_next;
+            sampled = common_sampler_sample(smpl, lctx, -1);
+            common_sampler_accept(smpl, sampled, true);
+            const int64_t t1 = ggml_vq_us();
+            f_us.push_back(t1 - t0);
+            d_us.push_back(st[0] - s0[0]);
+            c_us.push_back(st[1] - s0[1]);
+            b_us.push_back(st[2] - s0[2]);
+            if (n_frames == n_skip) {
+                ctr_b = vq_ctr_json(&hz);
+            }
+        }
+        const int64_t t_g1 = ggml_vq_us();
+        const std::string ctr_c = vq_ctr_json(&hz); // fine generazione
+        if (ctr_b.empty()) {
+            ctr_b = ctr_c;
+        }
+
+        int32_t      sample_rate = 0;
+        const char * data        = nullptr;
+        size_t       data_len    = 0;
+        int64_t      n_samples   = 0;
+        const int64_t t_o0 = ggml_vq_us();
+        if (gen.get_output(&sample_rate, &data, &data_len, &n_samples) != 0) {
+            LOG_ERR("VQ_BATCH %s: get_output failed\n", name.c_str());
+            return 1;
+        }
+        const int64_t t_o1 = ggml_vq_us();
+
+        if (FILE * f = fopen((out_pre + name + ".wav").c_str(), "wb")) {
+            fwrite(data, 1, data_len, f);
+            fclose(f);
+        } else {
+            LOG_ERR("VQ_BATCH %s: non posso scrivere il wav\n", name.c_str());
+            return 1;
+        }
+        size_t n_codes = 0;
+        const int32_t * codes = mtmd_helper_vq_codes(&n_codes);
+        if (FILE * f = fopen((out_pre + name + ".codes").c_str(), "wb")) {
+            fwrite(codes, sizeof(int32_t), n_codes, f);
+            fclose(f);
+        } else {
+            LOG_ERR("VQ_BATCH %s: non posso scrivere i codici\n", name.c_str());
+            return 1;
+        }
+        const std::string sys1 = vq_sys(sys_files, tasks);
+        const int64_t t_w1 = ggml_vq_us();
+
+        std::string j = "{\"name\":" + vq_json(name) + ",\"warm\":" + std::to_string(warm) + ",\"n_frames\":" + std::to_string(n_frames) +
+            ",\"n_codes\":" + std::to_string(n_codes) + ",\"n_samples\":" + std::to_string(n_samples) + ",\"sr\":" + std::to_string(sample_rate) +
+            ",\"wav_bytes\":" + std::to_string(data_len) + ",\"wall_us\":" + std::to_string(t_w1 - t_w0) +
+            ",\"t_prompt_us\":" + std::to_string(t_p1 - t_p0) + ",\"t_gen_us\":" + std::to_string(t_g1 - t_g0) + ",\"t_out_us\":" + std::to_string(t_o1 - t_o0) +
+            ",\"hz\":" + std::to_string(hz) + ",\"frame_us\":" + vq_arr(f_us) + ",\"depth_us\":" + vq_arr(d_us) +
+            ",\"codec_us\":" + vq_arr(c_us) + ",\"bb_us\":" + vq_arr(b_us) +
+            ",\"ctr_a\":" + ctr_a + ",\"ctr_b\":" + ctr_b + ",\"ctr_c\":" + ctr_c +
+            ",\"sys0\":" + sys0 + ",\"sys1\":" + sys1 + "}\n";
+        fwrite(j.data(), 1, j.size(), jl);
+        fflush(jl);
+        LOG_INF("VQ %s%s: %d frames, gen %.3fs (%.2f ms/frame), wall %.3fs\n", name.c_str(), warm ? " (warm-up)" : "", n_frames,
